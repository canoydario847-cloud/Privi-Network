# Server-side configuration TEMPLATE ONLY: never commit live keys!
# All activation conditions must be satisfied. Mr. Lee is OFF by default.
MR_LEE_ENABLED=false
OPENAI_API_KEY=
MR_LEE_MODEL=gpt-4.1-mini
# 32+ character random secret, configure ONLY in website server AND private gateway secret vaults.
MR_LEE_GATEWAY_TOKEN=
# Final reviewed PRVI MAINNET EVM numeric ID, NOT TEST (262144), NOT demo (999991).
PRIVI_MAINNET_EVM_CHAIN_ID=
# Final independent-reviewed live EVM block-0 hash, with 0x prefix.
PRIVI_EVM_GENESIS_BLOCK_HASH=
# Trusted real HTTPS endpoint to financial Privi mainnet RPC, not TEST.
PRIVI_MAINNET_EVM_RPC_URL=
# Exact HTTPS official Privi website origins (not wildcard).
MR_LEE_ALLOWED_ORIGINS=
# Set in website backend on deployment, NOT browser.
MR_LEE_WEBSITE_ORIGIN=
MR_LEE_PRIVATE_GATEWAY_URL=
# Private backend loopback unless explicitly routed behind authenticated proxy.
MR_LEE_BIND_HOST=127.0.0.1
PORT=8091
