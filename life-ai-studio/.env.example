# Server and durable volume
LIFE_DB_PATH=./data/life-studio.sqlite3
LIFE_COOKIE_SECURE=0
PUBLIC_ORIGIN=http://localhost:8080
# Provider keys stay SERVER SIDE; never place them in the browser or Git.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
XAI_API_KEY=
XAI_MODEL=
# Hey Jose must expose a separate trusted agent HTTP endpoint; its current
# OAuth/plugin backend is not an inference endpoint.
JOSE_AGENT_URL=
JOSE_AGENT_KEY=
# Optional allowlisted OpenAI-compatible agent:
EXTRA_AGENT_URL=
EXTRA_AGENT_NAME=custom
EXTRA_AGENT_KEY=
EXTRA_AGENT_MODEL=
# Native PRVI spending is OFF until an audited production mainnet is verified.
PRVI_MAINNET_PAYMENTS_ENABLED=0
PRVI_EVM_CHAIN_ID=
# Mandatory independently verified genesis hash.
PRVI_GENESIS_BLOCK_HASH=
PRVI_RPC_URL=
PRVI_TREASURY_ADDRESS=
PRVI_WEI_PER_CREDIT=
PRVI_REQUIRED_CONFIRMATIONS=12
# Service-to-service Privi utility charge API (a different secret for each service).
PRIVI_SERVICE_KEYS_JSON={}
# Development only; grants valueless trial credits, not real PRVI.
LIFE_DEV_TRIAL_CREDITS=0

# Optional reviewed ERC-20 registry for DISPLAY ONLY, never swaps:
# PRIVI_REVIEWED_ASSETS_JSON=[{"symbol":"SAMP","chain_id":8453,"contract":"0x1111111111111111111111111111111111111111","decimals":18}]
PRIVI_REVIEWED_ASSETS_JSON=[]
# No enabled trading/bridge execution flag exists until routes are security audited.

# Render free staging: no real signups, wallets, deposits, purchases or provider payments.
LIFE_STAGING_ONLY=0
\n# REQUIRED for production Ed25519 issuance; 64 hex characters, generated & stored securely:
# PRIVI_COGVATIVE_ED25519_SEED=<secret generated from os.urandom(32).hex()>
# Historical backfill does not imply agent identity or source license.

# Separately issued BNB Chain PRIV token checkout — OFF by default.
# Exact BNB token contract formerly identified by founder (must still be independently verified):
# BNB_PRIV_TOKEN_ADDRESS=0xbf154Ff2577F4B85db7B2ee910Db5880D06e0f64
# BNB_PRIV_TREASURY_ADDRESS=<merchant BSC address authorized to collect real PRIV>
# BNB_PRIV_RPC_URL=<trusted HTTPS BSC mainnet JSON-RPC>
# BNB_PRIV_CODE_SHA256=<sha256 of raw eth_getCode runtime bytes>
# BNB_PRIV_DECIMALS=<verified eth_call decimals()>
# BNB_PRIV_UNITS_PER_CREDIT=<fixed amount of smallest PRIV token units per LIFE credit>
BNB_PRIV_PAYMENTS_ENABLED=0
BNB_PRIV_REQUIRED_CONFIRMATIONS=12
# Enabled only on secure non-staging production with persistent DB and backups.
