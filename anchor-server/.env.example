# Privi chain JSON-RPC and EVM chain ID (devnet defaults)
ANCHOR_RPC_URL=https://privi-evm-devnet-development.up.railway.app
ANCHOR_CHAIN_ID=262144
ANCHOR_NETWORK_NAME=Privi EVM Devnet (valueless TEST gas)
# Service wallet that signs anchor transactions. Hot key: hold only gas, never real funds.
ANCHOR_PRIVATE_KEY=
# Comma-separated API keys allowed to call anchor_hashes
ANCHOR_API_KEYS=
ANCHOR_RATE_PER_MIN=30
ANCHOR_DB_PATH=anchor.db
# Optional block explorer prefix for tx links, e.g. https://explorer.example/tx/
ANCHOR_EXPLORER_TX_URL=
# Allow anchor_hashes over stdio without a key (local use only)
ANCHOR_ALLOW_LOCAL=0
