# Wallet that receives USDC payments (public address only, never a private key)
PRIVI_PAY_TO=0x1990589FD200E043b8C6FD9ec5956c61b3071048

# base-sepolia (testnet, default) or base (real money)
PRIVI_NETWORK=base-sepolia

# Public x402 facilitator is testnet only. For mainnet, use a production facilitator
# (e.g. Coinbase CDP) and put its Authorization header value in PRIVI_FACILITATOR_AUTH.
PRIVI_FACILITATOR_URL=https://x402.org/facilitator
# Mainnet: https://api.cdp.coinbase.com/platform/v2/x402
PRIVI_FACILITATOR_AUTH=

# Set to false to make every tool free (local development)
PRIVI_PAYMENTS_ENABLED=true

# Prices in USD (paid in USDC)
PRIVI_PRICE_VERIFY_LOT=0.01
PRIVI_PRICE_CHAIN_OF_CUSTODY=0.05

# Comma-separated API keys manufacturers use to record events
# (sent as "Authorization: Bearer <key>"). Generate long random values.
PRIVI_WRITE_KEYS=

# SQLite file. On Railway/Render, point this at a mounted volume, e.g. /data/privi.db
PRIVI_DB_PATH=privi.db

# Allow privi_record_event over stdio without a key (local use only)
PRIVI_ALLOW_LOCAL_WRITES=0

# Load demo lots DEMO-STEEL-0001 and DEMO-FOOD-0001 at startup (safe to leave on; idempotent)
PRIVI_SEED_DEMO=0

# On-chain checkpoints via Privi Anchor (empty key = off)
PRIVI_ANCHOR_URL=https://privi-anchor-production.up.railway.app/mcp
PRIVI_ANCHOR_KEY=
PRIVI_ANCHOR_INTERVAL=300

# Coinbase Developer Platform facilitator (required for Base mainnet). Never commit real values.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
