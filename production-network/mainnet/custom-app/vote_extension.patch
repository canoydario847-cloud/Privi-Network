@@ -0,0 +1,44 @@
+package evmd
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"fmt"
+
+	abci "github.com/cometbft/cometbft/abci/types"
+	sdk "github.com/cosmos/cosmos-sdk/types"
+)
+
+// This commitment is carried inside the validator's signed CometBFT extension.
+// It binds the proposed block to the chain and height. Admission, quorum and
+// previous-height proposal validation are separate consensus checks.
+func prviVoteCommitment(chain string, height int64, block []byte) ([]byte, error) {
+	if chain == "" || height < 1 || len(block) != sha256.Size {
+		return nil, fmt.Errorf("invalid PRVI vote context")
+	}
+	data := []byte("PRVI/vote-extension/v1\x00")
+	data = binary.BigEndian.AppendUint64(data, uint64(len(chain)))
+	data = append(data, chain...)
+	data = binary.BigEndian.AppendUint64(data, uint64(height))
+	data = append(data, block...)
+	digest := sha256.Sum256(data)
+	return digest[:], nil
+}
+
+func extendPrviVote(ctx sdk.Context, req *abci.RequestExtendVote) (*abci.ResponseExtendVote, error) {
+	digest, err := prviVoteCommitment(ctx.ChainID(), req.Height, req.Hash)
+	if err != nil {
+		return nil, err
+	}
+	return &abci.ResponseExtendVote{VoteExtension: digest}, nil
+}
+
+func verifyPrviVote(ctx sdk.Context, req *abci.RequestVerifyVoteExtension) (*abci.ResponseVerifyVoteExtension, error) {
+	status := abci.ResponseVerifyVoteExtension_REJECT
+	digest, err := prviVoteCommitment(ctx.ChainID(), req.Height, req.Hash)
+	if err == nil && bytes.Equal(req.VoteExtension, digest) {
+		status = abci.ResponseVerifyVoteExtension_ACCEPT
+	}
+	return &abci.ResponseVerifyVoteExtension{Status: status}, nil
+}
diff --git a/evmd/prvi_vote_test.go b/evmd/prvi_vote_test.go
