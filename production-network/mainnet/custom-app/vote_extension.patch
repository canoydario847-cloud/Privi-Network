@@ -0,0 +1,42 @@
+package evmd
+
+import (
+	"bytes"
+	"encoding/hex"
+	"testing"
+
+	abci "github.com/cometbft/cometbft/abci/types"
+	sdk "github.com/cosmos/cosmos-sdk/types"
+)
+
+func TestPrviVoteExtension(t *testing.T) {
+	ctx := sdk.Context{}.WithChainID("prvi-test")
+	block := bytes.Repeat([]byte{1}, 32)
+	ext, err := extendPrviVote(ctx, &abci.RequestExtendVote{Height: 9, Hash: block})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if hex.EncodeToString(ext.VoteExtension) != "5f18ada5276e4e4386eb5b49f10b9d516fb770f836db6b4f3b0cfcfc2dc7a314" {
+		t.Fatal("unexpected wire digest")
+	}
+	for _, tc := range []struct {
+		name, chain string
+		height      int64
+		hash, ext   []byte
+		accept      bool
+	}{
+		{"valid", "prvi-test", 9, block, ext.VoteExtension, true},
+		{"other chain", "other", 9, block, ext.VoteExtension, false},
+		{"other height", "prvi-test", 10, block, ext.VoteExtension, false},
+		{"other block", "prvi-test", 9, make([]byte, 32), ext.VoteExtension, false},
+		{"missing extension", "prvi-test", 9, block, nil, false},
+		{"invalid context", "", 0, nil, nil, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			res, err := verifyPrviVote(ctx.WithChainID(tc.chain), &abci.RequestVerifyVoteExtension{Height: tc.height, Hash: tc.hash, VoteExtension: tc.ext})
+			if err != nil || (res.Status == abci.ResponseVerifyVoteExtension_ACCEPT) != tc.accept {
+				t.Fatalf("unexpected result %v %v", res, err)
+			}
+		})
+	}
+}
