# DO NOT FILL WITH OR SHARE PRIVATE KEYS. Template only; do not commit operator .env files.
# Approved immutable image once built, signed and externally audited.
PRIVI_NODE_IMAGE=registry.example.invalid/privi/evmd@sha256:REPLACE_WITH_SIGNED_REAL_DIGEST
# Bind public P2P ONLY on the operator's dedicated sentry IP, not 0.0.0.0.
PRIVI_P2P_BIND_ADDRESS=REPLACE_WITH_SENTRY_PUBLIC_IP
# Values used only by local operator_preflight.py after release review.
APPROVED_GENESIS_SHA256=REPLACE_WITH_ACTUAL_GENESIS_DIGEST
PRIVI_COSMOS_CHAIN_ID=REPLACE_WITH_UNIQUE_MAINNET_CHAIN_ID
PRIVI_EVM_CHAIN_ID=REPLACE_WITH_APPROVED_NUMERIC_EVM_CHAIN_ID
