# Wallet that receives auditor payments (public address only)
LEDGER_PAY_TO=0x1990589FD200E043b8C6FD9ec5956c61b3071048
# base-sepolia (testnet, default) or base (real money; needs a production facilitator)
LEDGER_NETWORK=base-sepolia
LEDGER_FACILITATOR_URL=https://x402.org/facilitator
LEDGER_FACILITATOR_AUTH=
LEDGER_PAYMENTS_ENABLED=true
LEDGER_PRICE_AUDIT_STREAM=0.02
# Secret for POST /admin/orgs (creating customer organizations). Long and random.
LEDGER_ADMIN_KEY=
# SQLite file; on Railway point at the mounted volume
LEDGER_DB_PATH=ledger.db
# Org API key used for stdio (local) connections, which have no HTTP headers
LEDGER_LOCAL_ORG_KEY=

# On-chain checkpoints via Privi Anchor (empty key = off)
LEDGER_ANCHOR_URL=https://privi-anchor-production.up.railway.app/mcp
LEDGER_ANCHOR_KEY=
LEDGER_ANCHOR_INTERVAL=300

# Self-serve plans
LEDGER_FREE_MONTHLY=500
LEDGER_PRICE_PRO_MONTH=29
LEDGER_SIGNUPS_PER_HOUR=20
